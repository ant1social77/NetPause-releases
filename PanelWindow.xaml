<Window x:Class="NetPause.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetPause"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="NetPause" Width="420" Height="624"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- все списки в панели: плавная прокрутка и прокрутка пальцем на сенсорном экране -->
        <Style TargetType="ScrollViewer">
            <Setter Property="local:SmoothScroll.Enabled" Value="True"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- тонкая полоса прокрутки: ползунок утолщается при наведении и перетаскивании -->
        <Style x:Key="TrackBtn" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="b" Width="4" CornerRadius="3" HorizontalAlignment="Center"
                                Background="{DynamicResource Fg2}" Opacity="0.5"/>
                        <ControlTemplate.Triggers>
                            <!-- при наведении ползунок плавно утолщается и становится ярче, при уходе — плавно обратно -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Width"
                                                             To="7" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity"
                                                             To="0.85" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Width"
                                                             To="4" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity"
                                                             To="0.5" Duration="0:0:0.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="0,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource TrackBtn}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource TrackBtn}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimThumb}" MinHeight="24"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- переключатель: кружок плавно переезжает с лёгкой «пружинкой», цвет дорожки плавно перетекает
             (движение делает Motion.SmoothSwitch, подсветка при наведении — анимация ниже) -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="local:Motion.SmoothSwitch" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22" Background="Transparent">
                            <Border CornerRadius="11" Background="{DynamicResource SwitchOff}"/>
                            <Border x:Name="trackOn" CornerRadius="11" Background="{DynamicResource On}" Opacity="0"/>
                            <Border x:Name="glow" CornerRadius="11" Background="White" Opacity="0"/>
                            <Ellipse x:Name="thumb" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0.1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.35"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- текстовая кнопка: при наведении плавно становится ярче -->
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="6,2">
                            <ContentPresenter x:Name="cp" Opacity="0.85"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="cp" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="cp" Storyboard.TargetProperty="Opacity"
                                                             To="0.85" Duration="0:0:0.35"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- круглый переключатель выбора: точка внутри плавно вырастает (Motion.SmoothRadio) -->
        <Style x:Key="Radio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="local:Motion.SmoothRadio" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="ring" Stroke="{DynamicResource Fg2}" StrokeThickness="1.5"/>
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource On}"
                                         RenderTransformOrigin="0.5,0.5"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource On}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- вкладка: подчёркнута, когда выбрана -->
        <!-- верхние вкладки: подчёркивание у них общее и переезжает к выбранной (TabIndicator) -->
        <!-- вкладка: текст плавно светлеет при выборе и наведении (Motion.FadeTab);
             подчёркивание общее на ряд вкладок и переезжает к выбранной -->
        <Style x:Key="TopTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="local:Motion.FadeTab" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="6,6,6,9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tab" TargetType="RadioButton" BasedOn="{StaticResource TopTab}"/>
        <!-- переключатель из нескольких сегментов: под выбранным плавно переезжает «таблетка» (ModePill) -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="local:Motion.FadeTab" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border CornerRadius="5" Padding="4,6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- кнопка-«таблетка»: при наведении плавно подсвечивается -->
        <!-- меню правой кнопки в цветах оформления -->
        <Style x:Key="NpMenu" TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NpMenuItem" TargetType="MenuItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="12,7">
                            <ContentPresenter ContentSource="Header" TextBlock.FontSize="13"
                                              TextBlock.Foreground="{DynamicResource Fg}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
            <!-- светлая кнопка с тёмным текстом: так надпись хорошо видна в любом оформлении -->
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="11" BorderThickness="1"
                                    BorderBrush="{DynamicResource Line}" Background="{TemplateBinding Background}"/>
                            <Border x:Name="hov" CornerRadius="11" Background="{DynamicResource Hover}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" Margin="10,3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.35"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- капля: знак оформления «Кровь» и шкала остатка -->
        <PathGeometry x:Key="DropGeo"
                      Figures="M32,3 C32,3 7,36 7,55 C7,69.4 18.2,81 32,81 C45.8,81 57,69.4 57,55 C57,36 32,3 32,3 Z"/>
        <DrawingImage x:Key="DropImg">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#E01E37" Geometry="{StaticResource DropGeo}"/>
                    <GeometryDrawing Brush="#55FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="21,53" RadiusX="4.6" RadiusY="10.5">
                                <EllipseGeometry.Transform><RotateTransform Angle="20" CenterX="21" CenterY="53"/></EllipseGeometry.Transform>
                            </EllipseGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <!-- демонёнок: «не пускаю» у заблокированных программ (оформление «Кровь») -->
        <DrawingImage x:Key="DemonImg">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#E01E37" Geometry="M3.2,6 L4,1.5 L6.4,4.6 Z"/>
                    <GeometryDrawing Brush="#E01E37" Geometry="M12.8,6 L12,1.5 L9.6,4.6 Z"/>
                    <GeometryDrawing Brush="#E01E37">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="8,9.2" RadiusX="5.6" RadiusY="5.6"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M5.2,8.2 L7,9 M10.8,8.2 L9,9">
                        <GeometryDrawing.Pen><Pen Brush="#0F0A0B" Thickness="1.2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M6,11.5 Q8,13 10,11.5">
                        <GeometryDrawing.Pen><Pen Brush="#0F0A0B" Thickness="1" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- строка программы -->
        <DataTemplate x:Key="AppRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                    Padding="16,9" Background="Transparent" ToolTip="{Binding Path}"
                    Cursor="Hand" MouseLeftButtonUp="Row_Click" local:Motion.Hover="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,12,0"
                           VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" FontSize="12"
                                   Foreground="{Binding SubBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- статус «заблокировано» отдельной плашкой: её не обрезает многоточие -->
                    <Border Grid.Column="2" CornerRadius="10" Padding="5,2,8,2" Margin="0,0,8,0"
                            VerticalAlignment="Center" Background="{DynamicResource BadgeBg}"
                            Visibility="{Binding ChipVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource DemonImg}" Width="14" Height="14" Margin="0,0,4,0"
                                   Visibility="{Binding DemonVisibility}"/>
                            <TextBlock Text="{Binding ChipText}" FontSize="11" Foreground="{DynamicResource BadgeFg}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <CheckBox Grid.Column="3" Style="{StaticResource Switch}"
                              Visibility="{Binding SwitchVisibility}"
                              IsChecked="{Binding Allowed, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- строка-папка: «Windows», «Разовые установщики» -->
        <DataTemplate x:Key="FolderRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                    Padding="16,9" Background="Transparent" ToolTip="Открыть список"
                    Cursor="Hand" MouseLeftButtonUp="Folder_Click" local:Motion.Hover="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,12,0"
                            Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" FontSize="12"
                                   Foreground="{DynamicResource Fg2}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" Margin="0,0,8,0"
                              Visibility="{Binding SwitchVisibility}"
                              IsChecked="{Binding Allowed, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Fg2}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <local:RowSelector x:Key="RowSelector" AppTemplate="{StaticResource AppRow}"
                           FolderTemplate="{StaticResource FolderRow}"/>

        <!-- поле ввода в цветах темы -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Shell: вся панель целиком; вокруг — поле под мягкую тень, поэтому панель может плавно проявляться и гаснуть -->
    <Grid x:Name="Shell" Margin="12">
    <Border x:Name="ShadowBorder" CornerRadius="9" Background="{DynamicResource Bg}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.32" Color="Black"
                              RenderingBias="Performance"/>
        </Border.Effect>
    </Border>
    <Border x:Name="RootBorder" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Background="{DynamicResource Bg}">
      <!-- ClipHost обрезает содержимое по скруглённым углам -->
      <Grid x:Name="ClipHost" SizeChanged="ClipHost_SizeChanged">
        <!-- MainLayer: шапка, вкладки, страницы и подвал; поверх него выезжают папка и подробности -->
        <Grid x:Name="MainLayer">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="16,16,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <!-- капля-знак: видна в оформлении «Кровь» -->
                    <Image x:Name="Logo" Source="{StaticResource DropImg}" Width="18" Height="24" Margin="0,0,10,0"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel>
                        <TextBlock x:Name="StatusText" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusSub" FontSize="12.5" Foreground="{DynamicResource Fg2}"
                                   TextWrapping="Wrap" Margin="0,2,8,0"/>
                    </StackPanel>
                </StackPanel>
                <CheckBox x:Name="Master" Grid.Column="1" Style="{StaticResource Switch}" Click="Master_Click"/>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
              <Grid>
                <StackPanel x:Name="TabBar" Orientation="Horizontal" Margin="6,0">
                    <RadioButton x:Name="TabApps" Content="Программы" GroupName="tabs" IsChecked="True"
                                 Style="{StaticResource TopTab}" Click="Tab_Click"/>
                    <RadioButton x:Name="TabTranslator" Content="Транслятор" GroupName="tabs"
                                 Style="{StaticResource TopTab}" Click="Tab_Click"/>
                    <RadioButton x:Name="TabStats" Content="Статистика" GroupName="tabs"
                                 Style="{StaticResource TopTab}" Click="Tab_Click"/>
                    <RadioButton x:Name="TabNetworks" Content="Сети" GroupName="tabs"
                                 Style="{StaticResource TopTab}" Click="Tab_Click"/>
                    <RadioButton x:Name="TabSettings" Content="Настройки" GroupName="tabs"
                                 Style="{StaticResource TopTab}" Click="Tab_Click"/>
                </StackPanel>
                <!-- общее подчёркивание выбранной вкладки: плавно переезжает и меняет ширину -->
                <Border x:Name="TabIndicator" Height="2" CornerRadius="1" Width="0" Background="{DynamicResource On}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TabIndicatorX"/>
                    </Border.RenderTransform>
                </Border>
              </Grid>
            </Border>

            <Border x:Name="SummaryCard" Grid.Row="2" Margin="16,0,16,12" Padding="12" CornerRadius="8"
                    Background="{DynamicResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- шкала остатка: вид зависит от оформления -->
                    <Grid x:Name="GaugeBox" Margin="0,0,14,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <!-- «Кровь»: капля, уровень в ней — остаток трафика, поверхность медленно колышется -->
                        <Viewbox x:Name="DropGauge" Width="52" Height="68" Visibility="Collapsed">
                            <Canvas Width="64" Height="84">
                                <Path Data="{StaticResource DropGeo}" Fill="{DynamicResource GaugeEmpty}"/>
                                <Canvas Width="64" Height="84" Clip="{StaticResource DropGeo}">
                                    <Path Fill="{DynamicResource GaugeFill}"
                                          Data="M-64,0 Q-48,-5 -32,0 T0,0 T32,0 T64,0 T96,0 T128,0 V96 H-64 Z">
                                        <Path.RenderTransform>
                                            <TranslateTransform x:Name="WaveT" Y="3"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                                <Path Data="{StaticResource DropGeo}" Stroke="{DynamicResource On}" StrokeThickness="1.5"/>
                                <Ellipse Canvas.Left="16.5" Canvas.Top="43" Width="9" Height="21" Fill="White" Opacity="0.28"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><RotateTransform Angle="20"/></Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </Viewbox>
                        <!-- «Графит» — кольцо, «Орбита» — орбита со спутником -->
                        <Grid x:Name="RingGauge" Width="70" Height="70" Visibility="Collapsed">
                            <Ellipse x:Name="RingTrack" Stroke="{DynamicResource GaugeTrack}" StrokeThickness="7"/>
                            <Path x:Name="RingArc" Stroke="{DynamicResource GaugeFill}" StrokeThickness="7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Canvas>
                                <Ellipse x:Name="Satellite" Width="11" Height="11" Fill="{DynamicResource Fg}"
                                         Stroke="{DynamicResource BadgeFg}" StrokeThickness="3" Visibility="Collapsed"/>
                            </Canvas>
                            <TextBlock x:Name="RingText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12.5" FontWeight="SemiBold"/>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SumLabel" Text="Сегодня потрачено" FontSize="12.5" Foreground="{DynamicResource Fg2}"/>
                        <TextBlock x:Name="TotalText" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SumSub" FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SystemText" FontSize="12" Foreground="{DynamicResource Fg2}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- «Бумага»: полоса остатка -->
                    <Border x:Name="BarGauge" Grid.Row="1" Grid.ColumnSpan="2" Height="8" CornerRadius="4" Margin="0,10,0,0"
                            Background="{DynamicResource GaugeTrack}" Visibility="Collapsed">
                        <Border x:Name="BarFill" HorizontalAlignment="Left" CornerRadius="4" Width="0"
                                Background="{DynamicResource GaugeFill}"/>
                    </Border>
                </Grid>
            </Border>

            <TextBlock x:Name="WarnText" Grid.Row="3" Margin="16,0,16,10" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource Warn}" Visibility="Collapsed"/>

            <Grid x:Name="AppsArea" Grid.Row="4">
                <TextBlock x:Name="EmptyText" Margin="24" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource Fg2}"
                           Text="Программы появятся здесь, как только начнут пользоваться интернетом."/>
                <ScrollViewer x:Name="AppScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AppList" ItemTemplateSelector="{StaticResource RowSelector}"/>
                </ScrollViewer>
            </Grid>

            <!-- вкладка «Статистика»: закрывает собой карточку и список программ -->
            <Grid x:Name="StatsView" Grid.Row="2" Grid.RowSpan="3" Background="{DynamicResource Bg}"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="8,0,8,10">
                    <UniformGrid x:Name="PeriodBar" Rows="1">
                        <RadioButton x:Name="PSession" Content="Сессия" GroupName="period" IsChecked="True"
                                     Style="{StaticResource Tab}" Click="Period_Click"/>
                        <RadioButton x:Name="PDay" Content="День" GroupName="period"
                                     Style="{StaticResource Tab}" Click="Period_Click"/>
                        <RadioButton x:Name="PWeek" Content="Неделя" GroupName="period"
                                     Style="{StaticResource Tab}" Click="Period_Click"/>
                        <RadioButton x:Name="PAll" Content="Всё время" GroupName="period"
                                     Style="{StaticResource Tab}" Click="Period_Click"/>
                    </UniformGrid>
                    <!-- общее подчёркивание периода: плавно переезжает -->
                    <Border x:Name="PeriodIndicator" Height="2" CornerRadius="1" Width="0" Background="{DynamicResource On}"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PeriodIndicatorX"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <Border x:Name="StatCard" Grid.Row="1" Margin="16,0,16,12" Padding="12" CornerRadius="8"
                        Background="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="StatTotal" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatCaption" FontSize="12.5" Foreground="{DynamicResource Fg2}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Grid x:Name="StatListArea" Grid.Row="2">
                    <TextBlock x:Name="StatEmpty" Margin="24" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource Fg2}"
                               Text="За этот период трафика нет."/>
                    <ScrollViewer x:Name="StatScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="StatList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                            Padding="16,8" Background="Transparent" ToolTip="{Binding Path}"
                                            local:Motion.Hover="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0"
                                                   VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Share}" FontSize="12"
                                                           Foreground="{DynamicResource Fg2}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding BytesText}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- вкладка «Транслятор» -->
            <ScrollViewer x:Name="TranslatorView" Grid.Row="2" Grid.RowSpan="3" Background="{DynamicResource Bg}"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="16,0,16,12">
                    <!-- табло -->
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Включить транслятор" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="Маленькое табло поверх всех окон и игр: остаток трафика, скорость расхода и сколько потрачено с включения. Табло можно перетащить мышью в любое место."/>
                                </StackPanel>
                                <CheckBox x:Name="TranslatorSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                          VerticalAlignment="Top" Click="TranslatorSwitch_Click"/>
                            </Grid>
                            <TextBlock x:Name="TranslatorLive" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- трекеры -->
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Трекеры" FontWeight="SemiBold"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,3,0,4"
                                       Text="Сайт, где провайдер показывает, сколько трафика осталось. Трекер привязывается к сети: остаток и капля видны, только когда вы подключены к ней. Другие сети судна NetPause находит сам: если сайт трекера отвечает изнутри новой сети, она привязывается к нему."/>
                            <TextBlock x:Name="TrackerNetText" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TrackerBox" KeyDown="TrackerBox_KeyDown"
                                         ToolTip="Адрес сайта, например starlink.example.com"/>
                                <Button Grid.Column="1" Content="Добавить" Style="{StaticResource Pill}" Margin="8,0,0,0"
                                        Padding="0" Click="AddTracker_Click"/>
                            </Grid>
                            <TextBlock x:Name="TrackerError" FontSize="12" Foreground="{DynamicResource Warn}"
                                       Margin="0,4,0,0" Visibility="Collapsed"/>
                            <ItemsControl x:Name="TrackerList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton GroupName="trackers" IsChecked="{Binding Active, Mode=OneWay}"
                                                         Style="{StaticResource Radio}" Click="Tracker_Click"
                                                         IsEnabled="{Binding Enabled}"
                                                         ToolTip="Трекер сети, к которой вы подключены сейчас">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Networks}" FontSize="11.5" Foreground="{DynamicResource Fg2}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding NetworksVisibility}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <Button Grid.Column="1" Content="✕" Style="{StaticResource Link}" FontSize="11"
                                                    ToolTip="Убрать трекер" Click="TrackerRemove_Click"
                                                    Visibility="{Binding ForgetVisibility}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- остаток с выбранного трекера -->
                            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource Bg}">
                                <StackPanel>
                                    <TextBlock x:Name="TrackerRemain" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TrackerInfo" FontSize="12" Foreground="{DynamicResource Fg2}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TrackerData" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="Collapsed"/>
                                    <!-- устройства в сессии: появляется, только когда кроме ноутбука есть кто-то ещё -->
                                    <StackPanel x:Name="SessionBox" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock Text="В сессии" FontWeight="SemiBold" FontSize="12.5"/>
                                        <ItemsControl x:Name="SessionList" Margin="0,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{DynamicResource Fg2}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Отключить" Style="{StaticResource Link}" FontSize="12"
                                                                VerticalAlignment="Center" Tag="{Binding Ip}" Click="SessionRemove_Click"
                                                                Visibility="{Binding RemoveVisibility}"
                                                                ToolTip="Отключить это устройство от интернета на сайте. С него можно присоединиться снова."/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="SessionNote" FontSize="11.5" Foreground="{DynamicResource Fg2}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="TrackerOpenBtn" Content="Войти и открыть сайт" Style="{StaticResource Pill}"
                                                Margin="0,0,8,4" Click="TrackerOpen_Click"
                                                ToolTip="NetPause входит на трекер сохранёнными данными, включает интернет, если он выключен, и открывает сайт в браузере по умолчанию"/>
                                        <Button x:Name="TrackerRefreshBtn" Content="Обновить" Style="{StaticResource Pill}"
                                                Margin="0,0,8,4" Click="TrackerRefresh_Click"/>
                                        <Button x:Name="TrackerChangeBtn" Content="Сменить данные" Style="{StaticResource Link}"
                                                FontSize="12" Margin="0,0,8,4" Click="TrackerPassword_Click"
                                                ToolTip="Ввести другой логин или пароль от сайта трекера"/>
                                        <Button x:Name="TrackerLogoutBtn" Content="Забыть вход" Style="{StaticResource Link}"
                                                FontSize="12" Margin="0,0,0,4" Click="TrackerLogout_Click"/>
                                    </WrapPanel>
                                    <!-- настройки трекера текущей сети -->
                                    <StackPanel x:Name="TrackerSettings" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Включать интернет на сайте сам" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Text="Когда компьютер подключается к сети судна или включается, NetPause сам включает интернет на сайте трекера: заходить в браузер не нужно. Выключать интернет NetPause не будет."/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoDataSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Top" Click="AutoDataSwitch_Click"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="Суточная норма:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="DailyMbBox" Width="64" TextAlignment="Right"
                                                     KeyDown="DailyMbBox_KeyDown" LostFocus="DailyMbBox_LostFocus"/>
                                            <TextBlock Text="МБ" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DailyMbNote" FontSize="12" Foreground="{DynamicResource Fg2}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="DailyMbError" FontSize="12" Foreground="{DynamicResource Warn}"
                                                   Margin="0,4,0,0" Visibility="Collapsed" Text="Введите целое число от 1 до 1000000 или очистите поле."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Логин и пароль хранятся на этом компьютере в зашифрованном виде и уходят только на сайт трекера. Остаток спрашивается раз в минуту, а между ответами пересчитывается по тому, что ушло в интернет. Обмен внутри сети судна (например, с самим сайтом трекера) норму не тратит и не вычитается."/>
                        </StackPanel>
                    </Border>

                    <!-- тревога -->
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Тревога при резком расходе" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="Если за минуту уходит больше заданного, появится уведомление с кнопкой, которая выключает самую прожорливую программу. Работает и без табло."/>
                                </StackPanel>
                                <CheckBox x:Name="AlertSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                          VerticalAlignment="Top" Click="AlertSwitch_Click"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Порог:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="AlertMbBox" Width="64" TextAlignment="Right"
                                         KeyDown="AlertMbBox_KeyDown" LostFocus="AlertMbBox_LostFocus"/>
                                <TextBlock Text="МБ в минуту" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="AlertMbError" FontSize="12" Foreground="{DynamicResource Warn}"
                                       Margin="0,4,0,0" Visibility="Collapsed" Text="Введите целое число от 1 до 10000."/>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Звук уведомления" VerticalAlignment="Center"/>
                                <CheckBox x:Name="AlertSoundSwitch" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" Click="AlertSound_Click"/>
                            </Grid>
                            <Button Content="Показать пример уведомления" Style="{StaticResource Link}" FontSize="12"
                                    HorizontalAlignment="Left" Margin="-6,8,0,0" Click="TestAlert_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- вкладка «Сети» -->
            <ScrollViewer x:Name="NetworksView" Grid.Row="2" Grid.RowSpan="3" Background="{DynamicResource Bg}"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="16,0,16,12">
                    <!-- текущая сеть -->
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="Сейчас подключено" FontSize="12" Foreground="{DynamicResource Fg2}"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CurIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="CurName" FontSize="16" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="CurKind" FontSize="12" Foreground="{DynamicResource Fg2}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="CurPhoneBadge" Margin="0,8,0,0" Padding="8,4" CornerRadius="6"
                                    Background="{DynamicResource BadgeBg}" HorizontalAlignment="Left">
                                <TextBlock x:Name="CurPhoneText" FontSize="12" Foreground="{DynamicResource BadgeFg}"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="Экономия в этой сети" FontSize="12" Foreground="{DynamicResource Fg2}"
                                       Margin="0,12,0,6"/>
                            <Border CornerRadius="7" Background="{DynamicResource Bg}" Padding="3">
                                <Grid>
                                    <!-- «таблетка» под выбранным режимом: плавно переезжает -->
                                    <Border x:Name="ModePill" CornerRadius="5" Background="{DynamicResource Card}"
                                            HorizontalAlignment="Left" Width="0" Opacity="0" IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ModePillX"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <UniformGrid x:Name="ModeGrid" Rows="1" SizeChanged="ModeGrid_SizeChanged">
                                        <RadioButton x:Name="ModeOn" Content="Включать" GroupName="netmode"
                                                     Style="{StaticResource Seg}" Click="Mode_Click"/>
                                        <RadioButton x:Name="ModeNone" Content="Не трогать" GroupName="netmode"
                                                     Style="{StaticResource Seg}" Click="Mode_Click"/>
                                        <RadioButton x:Name="ModeOff" Content="Выключать" GroupName="netmode"
                                                     Style="{StaticResource Seg}" Click="Mode_Click"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                            <Grid Margin="0,6,0,0">
                                <TextBlock x:Name="ModeNote" FontSize="12" Foreground="{DynamicResource Fg2}"
                                           TextWrapping="Wrap" Margin="0,0,4,0"/>
                            </Grid>
                            <Button x:Name="ModeAutoBtn" Content="Вернуть автоматический выбор" Style="{StaticResource Link}"
                                    FontSize="12" HorizontalAlignment="Left" Margin="-6,2,0,0" Click="ModeAuto_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- автоматическое распознавание раздачи -->
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Узнавать раздачу с телефона" FontWeight="SemiBold"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Экономия включается сама, когда компьютер подключается к телефону по Wi-Fi, USB или Bluetooth, и выключается, когда вы с него уходите. Если экономию включили вы сами, она остаётся включённой."/>
                            </StackPanel>
                            <CheckBox x:Name="AutoHotspotSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                      VerticalAlignment="Top" Click="AutoHotspot_Click"/>
                        </Grid>
                    </Border>

                    <!-- все сети -->
                    <TextBlock Text="Все сети" FontWeight="SemiBold" Margin="2,16,0,2"/>
                    <TextBlock Text="Нажмите на правило справа, чтобы сменить его. Можно настроить и сети, к которым вы сейчас не подключены."
                               FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="2,0,0,8"/>
                    <Border CornerRadius="8" Background="{DynamicResource Card}">
                        <ItemsControl x:Name="NetList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                            Padding="12,8" Background="Transparent" local:Motion.Hover="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fg2}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           FontWeight="{Binding Weight}"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{DynamicResource Fg2}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{Binding RuleText}" Style="{StaticResource Pill}"
                                                    Background="{Binding RuleBg}" Foreground="{Binding RuleFg}" VerticalAlignment="Center"
                                                    ToolTip="Сменить правило" Click="NetRule_Click"/>
                                            <Button Grid.Column="3" Content="✕" Style="{StaticResource Link}" FontSize="11"
                                                    Margin="4,0,-6,0" VerticalAlignment="Center" ToolTip="Убрать из списка"
                                                    Visibility="{Binding ForgetVisibility}" Click="NetForget_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- вкладка «Настройки» -->
            <ScrollViewer x:Name="SettingsView" Grid.Row="2" Grid.RowSpan="3" Background="{DynamicResource Bg}"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="16,0,16,12">
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource Card}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Строгий режим" FontWeight="SemiBold"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Пока включена экономия, интернет запрещён всем, кроме отмеченных программ, включая те, которых ещё нет в списке, и неопознанный трафик. Программа, которая попробует выйти в сеть, появится в списке выключенной."/>
                                <TextBlock x:Name="StrictNote" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Fg2}"/>
                            </StackPanel>
                            <CheckBox x:Name="StrictSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                      VerticalAlignment="Top" Click="Strict_Click"/>
                        </Grid>
                    </Border>
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Лимитное подключение" FontWeight="SemiBold"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Пока включена экономия, текущая сеть Wi-Fi помечается в Windows как лимитная: система сама откладывает обновления и синхронизацию. При выключении экономии пометка снимается."/>
                                <TextBlock x:Name="MeteredNote" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Fg2}"/>
                            </StackPanel>
                            <CheckBox x:Name="MeteredSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                      VerticalAlignment="Top" Click="Metered_Click"/>
                        </Grid>
                    </Border>
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Имена сайтов в Chrome" FontWeight="SemiBold"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Chrome узнаёт адреса сайтов сам, мимо Windows, поэтому вместо имён часто видны числа. Переключатель велит Chrome пользоваться DNS Windows и выключает в нём DNS через HTTPS. Chrome покажет надпись «Управляется вашей организацией». Действует после перезапуска Chrome."/>
                            </StackPanel>
                            <CheckBox x:Name="ChromeSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                      VerticalAlignment="Top" Click="Chrome_Click"/>
                        </Grid>
                    </Border>

                    <!-- оформление -->
                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Оформление" FontWeight="SemiBold"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,3,0,8"
                                       Text="Цвета и вид панели. Меняются сразу, без перезапуска."/>
                            <ItemsControl x:Name="ThemeList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,7" CornerRadius="6" Background="Transparent" local:Motion.Hover="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton GroupName="theme" Style="{StaticResource Radio}"
                                                             IsChecked="{Binding Selected, Mode=OneWay}" Click="Theme_Click">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                                   Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </RadioButton>
                                                <!-- полоска цветов оформления -->
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Swatches}" Margin="8,0,0,0"
                                                              VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="12" Height="20" Background="{Binding}" Margin="1,0,0,0"
                                                                    CornerRadius="3" BorderBrush="{DynamicResource Line}" BorderThickness="0.5"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Значок у часов" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,6"/>
                            <ItemsControl x:Name="TrayIconList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,6" CornerRadius="6" Background="Transparent" local:Motion.Hover="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton GroupName="trayicon" Style="{StaticResource Radio}"
                                                             IsChecked="{Binding Selected, Mode=OneWay}" Click="TrayIcon_Click">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </RadioButton>
                                                <Image Grid.Column="1" Source="{Binding PreviewOn}" Width="22" Height="22" Margin="8,0,4,0"
                                                       ToolTip="Экономия включена"/>
                                                <Image Grid.Column="2" Source="{Binding PreviewOff}" Width="22" Height="22"
                                                       ToolTip="Экономия выключена"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionText" FontSize="11.5" Foreground="{DynamicResource Fg2}"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="5" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid>
                    <TextBlock x:Name="NetText" FontSize="12.5" Foreground="{DynamicResource Fg2}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,190,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AutoBtn" Content="Автозапуск" Style="{StaticResource Link}"
                                FontSize="12.5" Click="Auto_Click"/>
                        <Button Content="Выход" Style="{StaticResource Link}"
                                FontSize="12.5" Click="Exit_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
        <!-- конец MainLayer -->

            <!-- содержимое папки («Windows», «Разовые установщики»); закрывает собой всё -->
            <Grid x:Name="FolderView" Grid.RowSpan="6" Background="{DynamicResource Bg}" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="10,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="‹ Назад" Style="{StaticResource Link}" FontSize="14"
                            VerticalAlignment="Center" Click="FolderBack_Click"/>
                    <TextBlock x:Name="FolderGlyph" Grid.Column="1" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="20" Margin="8,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="FolderName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FolderSub" FontSize="12" Foreground="{DynamicResource Fg2}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="FolderNote" Grid.Row="1" Margin="16,0,16,10" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg2}"/>
                <ScrollViewer x:Name="FolderScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FolderList" ItemTemplate="{StaticResource AppRow}"/>
                </ScrollViewer>
            </Grid>

            <!-- экран подробностей по одной программе; закрывает собой всё -->
            <Grid x:Name="DetailView" Grid.RowSpan="6" Background="{DynamicResource Bg}" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="10,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="‹ Назад" Style="{StaticResource Link}" FontSize="14"
                            VerticalAlignment="Center" Click="Back_Click"/>
                    <Image x:Name="DetailIcon" Grid.Column="1" Width="24" Height="24" Margin="8,0,10,0"
                           VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="DetailName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DetailSub" FontSize="12" Foreground="{DynamicResource Fg2}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Margin="16,0,16,10" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg2}"
                           Text="Куда программа ходила сегодня. Сайты собраны вместе со всеми поддоменами, адреса без имени подписаны владельцем. Строка со стрелкой раскрывается щелчком. Выключенное блокируется, пока включена экономия."/>
                <Grid Grid.Row="2">
                    <TextBlock x:Name="DetailEmpty" Margin="24" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource Fg2}"
                               Text="Пока нет данных. Адреса появятся, когда программа выйдет в интернет."/>
                    <ScrollViewer x:Name="HostScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HostList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- заголовок группы -->
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                                Padding="8,8,16,8" Background="Transparent" Cursor="Hand"
                                                ToolTip="{Binding Tip}" MouseLeftButtonUp="Group_Click"
                                                local:Motion.Hover="True">
                                            <Border.ContextMenu>
                                                <ContextMenu Style="{StaticResource NpMenu}">
                                                    <MenuItem Header="Удалить из списка" Style="{StaticResource NpMenuItem}"
                                                              Click="ForgetSite_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- стрелка плавно поворачивается при раскрытии группы -->
                                                <TextBlock Text="{Binding ChevronGlyph}" FontSize="10" VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" Tag="chev"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Foreground="{DynamicResource Fg2}" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding ChevronAngle, Mode=OneTime}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <Grid Grid.Column="1" Width="28" Height="28" Margin="0,0,10,0">
                                                    <Border CornerRadius="14" Background="{Binding AvatarBg}"
                                                            Visibility="{Binding LetterVisibility}">
                                                        <TextBlock Text="{Binding Letter}" Foreground="White" FontSize="13"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- иконка сайта на светлой подложке, чтобы тёмные иконки были видны в тёмной теме -->
                                                    <Border CornerRadius="7" Background="White" Padding="4"
                                                            Visibility="{Binding IconVisibility}">
                                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Sub}" FontSize="12"
                                                               Foreground="{DynamicResource Fg2}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="3" Style="{StaticResource Switch}"
                                                          Visibility="{Binding SwitchVisibility}"
                                                          IsChecked="{Binding Allowed, Mode=TwoWay}"/>
                                            </Grid>
                                        </Border>
                                        <!-- содержимое группы -->
                                        <!-- содержимое раскрывается «гармошкой» (Motion.Expand/Collapse) -->
                                        <ItemsControl ItemsSource="{Binding Children}" Tag="kids" ClipToBounds="True"
                                                      Visibility="{Binding ChildrenVisibility}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="64,5,16,5" Background="Transparent"
                                                            ToolTip="{Binding Host}" local:Motion.Hover="True">
                                                        <Border.ContextMenu>
                                                            <ContextMenu Style="{StaticResource NpMenu}">
                                                                <MenuItem Header="Удалить из списка" Style="{StaticResource NpMenuItem}"
                                                                          Click="ForgetSite_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Label}" FontSize="13"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Sub}" FontSize="11.5"
                                                                           Foreground="{DynamicResource Fg2}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                                                      Visibility="{Binding SwitchVisibility}"
                                                                      IsChecked="{Binding Allowed, Mode=TwoWay}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
      </Grid>
    </Border>
    </Grid>
</Window>
