<Window x:Class="NetPause.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetPause — тревога" Width="350" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" CornerRadius="10" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Warn}"
            BorderThickness="1" Padding="16,14" Opacity="0">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource Warn}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="10" Padding="6,4" Margin="8,0,-6,0" VerticalAlignment="Top"
                        Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Fg2}"
                        Style="{StaticResource Btn}" ToolTip="Закрыть" Click="Later_Click"/>
            </Grid>
            <TextBlock x:Name="BodyText" Margin="28,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"/>
            <StackPanel Orientation="Horizontal" Margin="28,14,0,0">
                <Button x:Name="ActBtn" Style="{StaticResource Btn}" Background="{DynamicResource Warn}"
                        BorderBrush="{DynamicResource Warn}" Foreground="White" FontWeight="SemiBold"
                        Click="Act_Click"/>
                <Button Content="Не сейчас" Style="{StaticResource Btn}" Margin="8,0,0,0"
                        Background="Transparent" BorderBrush="{DynamicResource Line}" Foreground="{DynamicResource Fg}"
                        Click="Later_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
