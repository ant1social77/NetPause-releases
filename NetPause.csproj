<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NetPause</AssemblyName>
    <RootNamespace>NetPause</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.1</Version>
    <ApplicationIcon>NetPause.ico</ApplicationIcon>
    <Product>NetPause</Product>
    <Description>NetPause — экономия трафика</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- база «IP-адрес → владелец» с iptoasn.com (общественное достояние), читается при запуске -->
    <None Update="Data\ip2asn-combined.tsv.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.*" />
    <!-- чтение базы иконок сайтов, которую ведёт сам Chrome -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
    <!-- окно сайта трекера, где человек сам входит в свой аккаунт -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <!-- шифрование сохранённого пропуска трекера средствами Windows -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.*" />
  </ItemGroup>

</Project>
